# Wallet Configuration
# Your Solana wallet private key (base58 encoded)
# IMPORTANT: Never commit your actual private key!
PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY_HERE

# RPC Configuration
# Get free RPC endpoints from Helius (https://helius.dev) or QuickNode (https://quicknode.com)
RPC_ENDPOINT=https://api.devnet.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.devnet.solana.com

# Trading Configuration
# QUOTE_MINT options: WSOL or USDC
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.1

# Network Configuration
# Options: processed, confirmed, finalized
COMMITMENT_LEVEL=finalized

# Snipe List Configuration
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=20000

# Security Checks
# Note: Enable these checks to reduce risk of rug pulls and scams
# Some checks are disabled by default as they may reduce trading opportunities
# For maximum security, consider enabling all checks: set all to true

# CHECK_IF_MINT_IS_RENOUNCED: Ensures token mint authority is revoked (prevents unlimited minting)
# Recommended: true (prevents developers from creating unlimited tokens)
CHECK_IF_MINT_IS_RENOUNCED=true

# CHECK_IF_IS_BURNED: Verifies liquidity pool tokens are burned (permanent liquidity lock)
# Recommended: true for higher security (disabled by default as it's more restrictive)
CHECK_IF_IS_BURNED=false

# CHECK_IF_IS_LOCKED: Checks if liquidity is locked in a time-lock contract (temporary protection)
# Recommended: true for higher security (disabled by default as it requires API access)
CHECK_IF_IS_LOCKED=false

# Auto-Sell Configuration
AUTO_SELL=true
MAX_SELL_RETRIES=5
AUTO_SELL_DELAY=30000

# Logging
# Options: trace, debug, info, warn, error
LOG_LEVEL=info

# Trading Parameters
TAKE_PROFIT=50
STOP_LOSS=30

# Birdeye API Configuration
# Get your free API key from: https://docs.birdeye.so/docs/authentication-api-keys
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY_HERE

# Pool Configuration
MIN_POOL_SIZE=1
