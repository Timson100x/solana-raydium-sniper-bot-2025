# Solana Raydium Sniper Bot Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================
# Your wallet private key in base58 format
# IMPORTANT: Never commit your actual private key to version control!
# For testing on devnet, you can generate a test wallet with: solana-keygen new
PRIVATE_KEY=your_wallet_private_key_base58_format_here

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# For testing on Solana Devnet (recommended for development):
# RPC_ENDPOINT=https://api.devnet.solana.com
# RPC_WEBSOCKET_ENDPOINT=wss://api.devnet.solana.com

# For production on Mainnet (requires paid RPC service for speed):
# Recommended providers: Helius, QuickNode, Shyft
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com

# Example with Helius (faster, recommended for production):
# RPC_ENDPOINT=https://rpc.helius.xyz?api-key=YOUR_API_KEY
# RPC_WEBSOCKET_ENDPOINT=wss://rpc.helius.xyz?api-key=YOUR_API_KEY

# Example with QuickNode:
# RPC_ENDPOINT=https://YOUR_ENDPOINT.quiknode.pro/YOUR_TOKEN/
# RPC_WEBSOCKET_ENDPOINT=wss://YOUR_ENDPOINT.quiknode.pro/YOUR_TOKEN/

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Which token to use for trading: WSOL or USDC
# WSOL is more common for Raydium pools
QUOTE_MINT=WSOL

# Amount to spend per trade (in WSOL or USDC)
# For testing on devnet, use small amounts like 0.01
# For production, adjust based on your strategy (e.g., 0.1 to 1.0 SOL)
QUOTE_AMOUNT=0.1

# Commitment level: processed, confirmed, or finalized
# finalized = slower but more reliable
# confirmed = faster but less reliable
COMMITMENT_LEVEL=finalized

# =============================================================================
# TOKEN FILTERING
# =============================================================================
# Only buy tokens from snipe-list.txt file (true/false)
USE_SNIPE_LIST=false

# How often to refresh snipe list (milliseconds)
SNIPE_LIST_REFRESH_INTERVAL=20000

# Check if mint authority is renounced (true/false)
# Renounced mints cannot create new tokens
CHECK_IF_MINT_IS_RENOUNCED=true

# Minimum pool size to consider (in quote token)
# Set to 0 to disable
MIN_POOL_SIZE=1

# =============================================================================
# AUTO-SELL CONFIGURATION
# =============================================================================
# Enable automatic selling (true/false)
AUTO_SELL=true

# Maximum number of sell attempts
MAX_SELL_RETRIES=5

# Delay before selling (milliseconds)
# Set to 0 to sell immediately after buy
AUTO_SELL_DELAY=30000

# Take profit percentage (e.g., 50 = 50% profit)
TAKE_PROFIT=50

# Stop loss percentage (e.g., 30 = 30% loss)
# Note: This is represented as a positive number
STOP_LOSS=30

# =============================================================================
# API KEYS
# =============================================================================
# Birdeye API Key for price checking and liquidity verification
# Get free API key at: https://docs.birdeye.so/docs/authentication-api-keys
BIRDEYE_API_KEY=your_birdeye_api_key_here

# =============================================================================
# LOGGING
# =============================================================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
