# Example Environment Configuration for Solana Raydium Sniper Bot
# Copy this file to .env and update with your actual values

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================
# Your wallet's private key in base58 format
# To get your private key:
# 1. Export from Phantom/Solflare wallet OR
# 2. Use: solana-keygen new --outfile ~/my-wallet.json
# 3. Convert to base58: cat ~/my-wallet.json | jq -r '.' | python3 -c "import sys,json,base58; print(base58.b58encode(bytes(json.load(sys.stdin))).decode())"
# WARNING: Never share this key or commit it to version control!
PRIVATE_KEY=your_base58_encoded_private_key_here

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# For testing on devnet:
# RPC_ENDPOINT=https://api.devnet.solana.com
# RPC_WEBSOCKET_ENDPOINT=wss://api.devnet.solana.com

# For production on mainnet (use fast RPC providers for better performance):
# Helius: https://helius.dev
# QuickNode: https://quicknode.com
# Shyft: https://shyft.to
RPC_ENDPOINT=https://rpc.shyft.to?api_key=YOUR_API_KEY
RPC_WEBSOCKET_ENDPOINT=wss://rpc.shyft.to?api_key=YOUR_API_KEY

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Which token to use for trading (WSOL or USDC)
QUOTE_MINT=WSOL

# Amount to spend on each token purchase (in WSOL/USDC)
# For testing, use small amounts like 0.01
QUOTE_AMOUNT=0.1

# Minimum pool size to trigger a buy (in WSOL/USDC)
# Set to 0 to disable this check
MIN_POOL_SIZE=1

# =============================================================================
# TRANSACTION SETTINGS
# =============================================================================
# Commitment level for transactions
# Options: processed, confirmed, finalized
# - processed: Fastest, least safe
# - confirmed: Balanced
# - finalized: Slowest, most safe
COMMITMENT_LEVEL=finalized

# =============================================================================
# SNIPE LIST CONFIGURATION
# =============================================================================
# Set to true to only buy tokens listed in snipe-list.txt
USE_SNIPE_LIST=false

# How often to refresh the snipe list (in milliseconds)
SNIPE_LIST_REFRESH_INTERVAL=20000

# =============================================================================
# SAFETY CHECKS
# =============================================================================
# Check if mint authority has been renounced (prevents rug pulls)
CHECK_IF_MINT_IS_RENOUNCED=true

# =============================================================================
# AUTO SELL CONFIGURATION
# =============================================================================
# Automatically sell tokens when take profit or stop loss is hit
AUTO_SELL=true

# Maximum number of retries for selling a token
MAX_SELL_RETRIES=5

# Delay before attempting to sell (in milliseconds)
# Set to 0 to sell immediately after buy
AUTO_SELL_DELAY=30000

# Take profit percentage (sell when profit reaches this %)
# Example: 50 means sell when price increases by 50%
TAKE_PROFIT=50

# Stop loss percentage (sell when loss reaches this %)
# Example: -30 means sell when price decreases by 30%
# Note: Must be a negative value
STOP_LOSS=-30

# =============================================================================
# API KEYS
# =============================================================================
# Birdeye API key for price data, burn/lock checks
# Get free API key at: https://docs.birdeye.so/docs/authentication-api-keys
BIRDEYE_API_KEY=your_birdeye_api_key_here

# =============================================================================
# LOGGING
# =============================================================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# TESTING ON DEVNET
# =============================================================================
# For safe testing without risking real funds:
# 1. Uncomment the devnet endpoints above
# 2. Get devnet SOL: solana airdrop 2 --url devnet
# 3. Set QUOTE_AMOUNT to a small value like 0.01
# 4. Monitor logs for any errors
# 5. Once working on devnet, switch to mainnet with caution
